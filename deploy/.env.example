# Copy to deploy/.env and fill in. Never commit or share the real file.
# Public address customers and staff use (no https:// prefix). Must point at this server for automatic HTTPS.
DOMAIN=till.myshop.co.zw
# Database password: long and random (letters and digits only avoids quoting problems).
DB_PASSWORD=change-me-to-a-long-random-password
# Signs sessions. At least 32 random characters.  Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-64-random-hex-characters
# shared = several isolated stores on this server.  single = lock this install to ONE store.
STORE_MODE=single
# Optional in single mode: the store's id if you ever have more than one row. Leave empty normally.
STORE_ID=
STORE_TIMEZONE=Africa/Harare
# Admin consoles sign out after this many idle minutes. Cashier/Kitchen stations stay signed in for the shift.
ADMIN_IDLE_MINUTES=30
# simulated = demo payments (card / EcoCash approve automatically). In production these are OFF unless you set ALLOW_SIMULATED_PAYMENTS=true.
PAYMENT_PROVIDER=simulated
ALLOW_SIMULATED_PAYMENTS=false
# Backups: hour of day (server time, 0-23) and days to keep.
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=30
