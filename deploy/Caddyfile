# Caddy gets and renews a free HTTPS certificate automatically for a public domain.
# For a shop network with no public domain, set DOMAIN=till.local (or localhost) and Caddy uses its own certificate;
# install Caddy's root certificate on tablets (see docs/DEPLOYMENT.md) so they trust it.
{$DOMAIN} {
	encode gzip
	reverse_proxy app:3001
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
	}
}
