# Server-side only. Never put this in VITE_ variables.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sstwas_dev
PORT=3001
NODE_ENV=development
# Set a long unique random value for production. Required outside development.
SESSION_SECRET=replace-with-at-least-32-random-characters
# For first account ONLY: set in local server/.env temporarily, run bootstrap then remove these lines.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-password
# Optional: display name for the first Super Admin.
# BOOTSTRAP_ADMIN_NAME=Your Name
# Optional (development only): creates demo Admin / Cashier / Kitchen accounts for each demo store when you run `npm run db:seed`.
# DEMO_STAFF_PASSWORD=Choose-A-Strong-Demo-Pass1

# ---- Production / deployment (see docs/DEPLOYMENT.md) ----
# Public https address (required when NODE_ENV=production), e.g. https://till.myshop.co.zw
# APP_ORIGIN=https://till.myshop.co.zw
# shared = several isolated stores on this server (default). single = locked to ONE store.
# STORE_MODE=single
# STORE_ID=
# Time zone used for end-of-day reports and CSV exports.
# STORE_TIMEZONE=Africa/Harare
# Seed or update the Chizzyboi grocery and food stores on startup.
# BOOTSTRAP_CHIZZYBOI_STORE=true
# Admin consoles sign out after this many idle minutes (cashier and kitchen stations stay signed in).
# ADMIN_IDLE_MINUTES=30
# Cash-only is the safe default; simulated payments are not enabled by default.
# PAYMENT_PROVIDER=cash-only
#
# Real payments with Paynow Zimbabwe (see docs/PAYNOW.md). Set PAYMENT_PROVIDER=paynow and fill these in:
# PAYMENT_PROVIDER=paynow
# PAYNOW_INTEGRATION_ID=1234
# PAYNOW_INTEGRATION_KEY=your-integration-key
# PAYNOW_AUTH_EMAIL=the-email-you-sign-in-to-paynow-with
# PAYNOW_MODE=test            # test = Paynow fakes payments, live = real money
# PAYNOW_CURRENCY=USD         # the currency of your Paynow integration (USD or ZIG)
# PAYNOW_EXPIRY_MINUTES=10    # unpaid orders release their stock after this long
# ALLOW_SIMULATED_PAYMENTS=false
# Serve the built web app from this process (default ../dist, created by npm run build).
# STATIC_DIR=../dist

# Permanent product-photo storage (Cloudinary). Add either CLOUDINARY_URL or all three CLOUDINARY_* values.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
